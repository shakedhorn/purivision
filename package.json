{
  "name": "purivision",
  "version": "1.0.0",
  "private": true,
  "description": "PuriVision - Live Voting & Eurovision Scoreboard System",
  "scripts": {
    "start": "node server/server.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "postinstall": "npm --prefix server install"
  }
}
