# PuriVision Server Environment Configuration

# Network Host & Port
# Free cloud hosts (Render, Railway) automatically provide the PORT environment variable
PORT=3001
HOST=0.0.0.0

# Admin Authentication Credentials
# CRITICAL: Change these values before deploying to production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_123

# Admin Session & Token Signing Secret
# Set to a strong, random secret string in production
ADMIN_SECRET_KEY=purivision_super_secret_jwt_key_2027

# CORS Allowed Origin
# Set to your frontend production URL (e.g., https://purivision.vercel.app)
# Use comma-separated URLs for multiple origins, or * for open access during development
CLIENT_URL=http://localhost:5173
